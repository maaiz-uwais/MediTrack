{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://meditrack-api-lovat.vercel.app/api/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "https://meditrack-api-lovat.vercel.app/uploads/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}